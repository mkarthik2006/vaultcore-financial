# VaultCore Financial — environment template.
# Copy to `.env` (which is gitignored) and adjust for your environment.
# These are DEV defaults. For production, source secrets from a secret manager.

# --- Application database ---
POSTGRES_DB=vaultcore
POSTGRES_USER=vaultuser
POSTGRES_PASSWORD=change-me

# --- Keycloak admin + database ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_DB=keycloak_db
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me
KEYCLOAK_DB_SCHEMA=public

# --- OAuth2 / OIDC (backend resource server) ---
OAUTH2_ISSUER_URI=http://vaultcore-keycloak:8080/realms/vaultcore
OAUTH2_JWK_SET_URI=http://vaultcore-keycloak:8080/realms/vaultcore/protocol/openid-connect/certs

# --- Optional tuning (sane defaults exist in application.yaml) ---
# APP_CORS_ALLOWED_ORIGINS=http://localhost:8082
# APP_RATE_LIMIT_ENABLED=true
# APP_RATE_LIMIT_RPM=300
# FRAUD_CHALLENGE_TTL_SECONDS=300
