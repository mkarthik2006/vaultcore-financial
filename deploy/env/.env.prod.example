# VaultCore Financial — PRODUCTION environment template (Oracle Cloud single VM).
# Copy to the repo root as `.env` on the server and fill in strong secrets + your domain.
#   cp deploy/env/.env.prod.example .env
# Generate strong secrets:  openssl rand -base64 24
#
# Replace vaultcore.example.com with your real domain (or the VM's public IP + nip.io, e.g.
# 203-0-113-10.nip.io, if you have no domain).

# ---------------------------------------------------------------------------
# Public domain (edit this one value in several places below)
# ---------------------------------------------------------------------------
# DOMAIN=vaultcore.example.com    # for reference only; not read by compose

# --- Application database ---
POSTGRES_DB=vaultcore
POSTGRES_USER=vaultuser
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# --- Keycloak admin + database ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_strong_admin_password
KEYCLOAK_DB=keycloak_db
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=CHANGE_ME_strong_kc_db_password
KEYCLOAK_DB_SCHEMA=public

# --- Keycloak public hostname (HTTPS, terminated at host nginx) ---
# The realm/token endpoints live under /auth on the domain (the gateway routes /auth -> keycloak).
KC_HOSTNAME_URL=https://vaultcore.example.com/auth
KC_HOSTNAME_ADMIN_URL=https://vaultcore.example.com/auth

# --- Backend OAuth2 resource server (MUST equal the token 'iss') ---
OAUTH2_ISSUER_URI=https://vaultcore.example.com/auth/realms/vaultcore
OAUTH2_JWK_SET_URI=https://vaultcore.example.com/auth/realms/vaultcore/protocol/openid-connect/certs

# --- Frontend build-time (Vite) — baked into the SPA bundle ---
VITE_KEYCLOAK_URL=https://vaultcore.example.com/auth
VITE_KEYCLOAK_REALM=vaultcore
VITE_KEYCLOAK_CLIENT_ID=vaultcore-frontend
VITE_API_BASE_URL=https://vaultcore.example.com

# --- App tuning ---
APP_CORS_ALLOWED_ORIGINS=https://vaultcore.example.com
APP_RATE_LIMIT_ENABLED=true
APP_RATE_LIMIT_RPM=300
FRAUD_CHALLENGE_TTL_SECONDS=300
